rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@corporativomaf[.]com');
    }

    // Solo administradores configuran el catálogo, pesos y pueden vaciar evaluaciones.
    function isAdmin() {
      return isStaff() && request.auth.token.email in ['magraz@corporativomaf.com'];
    }

    // Las evaluaciones se crean por instructores y solo un administrador puede eliminarlas.
    match /evaluations/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.phase is int
        && request.resource.data.phase >= 1 && request.resource.data.phase <= 6
        && request.resource.data.driverName is string
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.instructorEmail == request.auth.token.email
        && request.resource.data.marks is list;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /settings/catalog {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.weights is map
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 500;
    }

    match /settings/exercises {
      allow read: if isStaff();
      allow write: if isAdmin() && request.resource.data.phases is map;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
