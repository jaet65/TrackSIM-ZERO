rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@corporativomaf[.]com');
    }

    // Las evaluaciones solo se crean (con ID fase_archivo), nunca se editan ni se borran desde el cliente.
    match /evaluations/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.phase is int
        && request.resource.data.phase >= 1 && request.resource.data.phase <= 6
        && request.resource.data.driverName is string
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.instructorEmail == request.auth.token.email
        && request.resource.data.marks is list;
      allow update, delete: if false;
    }

    // Solo administradores configuran el catálogo y los pesos de calificación.
    function isAdmin() {
      return isStaff() && request.auth.token.email in ['magraz@corporativomaf.com'];
    }

    match /settings/catalog {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.weights is map
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 500;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
