{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/set-state-in-effect": "off"
  },
  "ignorePatterns": ["dist", "dist-electron", "release", "node_modules", "electron/preload.cjs"]
}
